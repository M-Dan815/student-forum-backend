{
	"info": {
		"name": "CV Review API",
		"description": "AI-powered CV review service using Gemini",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Analyze CV",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "cv",
							"type": "file",
							"src": "path/to/cv.pdf"
						},
						{
							"key": "targetRole",
							"value": "Software Engineer",
							"type": "text"
						},
						{
							"key": "experienceLevel",
							"value": "Junior",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{baseUrl}}/cv-review/analyze",
					"host": ["{{baseUrl}}"],
					"path": ["cv-review", "analyze"]
				}
			}
		},
		{
			"name": "Get Review History",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/cv-review/history?page=1&limit=10",
					"host": ["{{baseUrl}}"],
					"path": ["cv-review", "history"],
					"query": [
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "limit",
							"value": "10"
						}
					]
				}
			}
		},
		{
			"name": "Get Single Review",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/cv-review/{{reviewId}}",
					"host": ["{{baseUrl}}"],
					"path": ["cv-review", "{{reviewId}}"]
				}
			}
		},
		{
			"name": "Compare Versions",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/cv-review/compare?currentId={{currentReviewId}}&previousId={{previousReviewId}}",
					"host": ["{{baseUrl}}"],
					"path": ["cv-review", "compare"],
					"query": [
						{
							"key": "currentId",
							"value": "{{currentReviewId}}"
						},
						{
							"key": "previousId",
							"value": "{{previousReviewId}}"
						}
					]
				}
			}
		},
		{
			"name": "Get Stats",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/cv-review/stats",
					"host": ["{{baseUrl}}"],
					"path": ["cv-review", "stats"]
				}
			}
		}
	]
}
